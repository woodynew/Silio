---
import Default from "@astrojs/starlight/components/Pagination.astro";

const pageId = Astro.props.entry?.id || Astro.url.pathname;
---

<div class="mark-as-read-container">
  <label class="mark-as-read-label">
    <input type="checkbox" id="mark-read-checkbox" data-page-id={pageId} />
    <span>标记为已读（完成学习）</span>
  </label>
</div>

<Default {...Astro.props} />

<script>
  function setupMarkAsRead() {
    const checkbox = document.getElementById(
      "mark-read-checkbox",
    ) as HTMLInputElement | null;
    if (!checkbox) return;

    // Use the current page pathname as the reliable key
    const pageId =
      checkbox.getAttribute("data-page-id") || window.location.pathname;
    if (!pageId) return;

    const storageKey = "java-tutorial-progress";

    const getProgress = (): Record<string, boolean> => {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || "{}");
      } catch {
        return {};
      }
    };

    // Load saved state
    const progress = getProgress();
    // Match by pathname or stored key
    const normalizedPath = window.location.pathname;
    checkbox.checked = !!progress[normalizedPath] || !!progress[pageId];

    // Save on change
    checkbox.addEventListener("change", (e) => {
      const currentProgress = getProgress();
      const key = normalizedPath; // Always use pathname as key
      if ((e.target as HTMLInputElement).checked) {
        currentProgress[key] = true;
      } else {
        delete currentProgress[key];
      }
      localStorage.setItem(storageKey, JSON.stringify(currentProgress));

      window.dispatchEvent(new CustomEvent("progress-updated"));
    });
  }

  document.addEventListener("astro:page-load", setupMarkAsRead);
  setupMarkAsRead();
</script>

<style>
  .mark-as-read-container {
    margin-top: 2rem;
    padding: 1.5rem;
    background-color: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark-as-read-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .mark-as-read-label input[type="checkbox"] {
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    accent-color: var(--sl-color-text-accent);
  }
</style>
